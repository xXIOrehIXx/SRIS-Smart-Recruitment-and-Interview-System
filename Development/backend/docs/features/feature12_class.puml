@startuml Feature12_Class
skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam linetype ortho
skinparam nodesep 80
skinparam ranksep 80
hide circle

title **Feature 12: Interview Pool Management (Class Diagram)**

class InterviewPoolController <<boundary>> {
    - _poolService : InterviewPoolService
    + CreatePoolAsync(jobId : long, dto : Object) : Object
    + InviteAsync(poolId : long, dto : Object) : Object
}

class InterviewPoolService <<control>> {
    - _schedulingRepo : SchedulingRepository
    - _appRepo : ApplicationRepository
    - _magicLink : MagicLinkService
    - _stateService : ApplicationStateService
    + CreatePoolAsync(companyId : long, userId : long, jobId : long, dto : Object) : PoolDto
    + InviteAsync(companyId : long, userId : long, poolId : long, dto : Object) : InviteResultDto
}

class InterviewSlotPool <<entity>> {
    - poolId : long
    - jobId : long
    - roundNumber : int
    - status : string
}

class InterviewSlot <<entity>> {
    - slotId : long
    - poolId : long
    - startTime : DateTime
    - status : string
}

class InterviewSchedule <<entity>> {
    - scheduleId : long
    - applicationId : long
    - poolId : long
    - roundNumber : int
    - status : string
}

InterviewPoolController --> InterviewPoolService : Association
InterviewPoolService --> InterviewSlotPool : Dependency

InterviewSlotPool "1" *--> "*" InterviewSlot : Composition
InterviewSlotPool "1" *--> "*" InterviewSchedule : Composition

@enduml
