@startuml Feature12_Seq_2
skinparam maxMessageSize 150
skinparam sequenceMessageAlign center
skinparam roundcorner 5
skinparam minClassWidth 100

title **Feature 12: Interview Scheduling - Sequence: Cancel a Session**

actor Recruiter
participant "Web UI" as UI
participant "<<controller>>\nInterviewScheduleController" as Ctrl
participant "<<service>>\nInterviewScheduleService" as Svc
participant "<<repository>>\nSchedulingRepository" as Repo
participant "<<repository>>\nActivityLogRepository" as LogRepo
participant "<<service>>\nNotificationService" as Notify
participant "Database" as DB

Recruiter -> UI: Click "Cancel session"
activate UI

UI -> Ctrl: POST /api/interview-schedules/{id}/cancel
activate Ctrl

Ctrl -> Svc: CancelAsync(companyId, userId, scheduleId, dto)
activate Svc

Svc -> Repo: GetScheduleByIdAsync / GetSlotAsync
activate Repo
note right of Repo: Read the start time BEFORE cancelling\nso the email can name the session
Repo --> Svc: return schedule + slot
deactivate Repo

Svc -> Repo: CancelPoolAsync(companyId, poolId)
activate Repo
Repo -> DB: pool CANCELLED + slot LOCKED + schedule CANCELLED
activate DB
DB --> Repo: rows affected
deactivate DB
Repo --> Svc: return true/false
deactivate Repo

Svc -> LogRepo: InsertAsync(INTERVIEW_CANCELLED)
activate LogRepo
LogRepo --> Svc: ok
deactivate LogRepo

Svc -> Notify: SendInterviewCancelledAsync(...)
activate Notify
Notify --> Svc: ok
deactivate Notify

Svc --> Ctrl: void
deactivate Svc

Ctrl --> UI: 204 No Content
deactivate Ctrl

UI --> Recruiter: Session cancelled, candidate notified
deactivate UI
@enduml
