@startuml Feature2_Seq_2
skinparam maxMessageSize 150
skinparam sequenceMessageAlign center
skinparam roundcorner 5
skinparam minClassWidth 100

title **Feature 2: Automated Application Scoring - Sequence: Evaluate Criteria Match**

actor SystemTask
participant "<<worker>>\nCvScoringWorker" as Worker
participant "<<service>>\nCvScoringService" as Svc
participant "<<service>>\nEmbeddingClient" as LLM
participant "<<repository>>\nApplicationRepository" as AppRepo
participant "<<service>>\nCriteriaScoringService" as CriteriaSvc
participant "<<dbcontext>>\nAppDbContext" as DbContext
participant "Database" as DB

SystemTask -> Worker: ProcessQueueItem(appId)
activate Worker

Worker -> Svc: ScoreApplicationAsync(appId)
activate Svc

Svc -> LLM: EmbedAsync(cvText)
activate LLM
LLM --> Svc: return cvVector
deactivate LLM

Svc -> AppRepo: UpdateScoreAsync(appId, score)
activate AppRepo
AppRepo -> DbContext: ExecuteSql(Cosine Distance)
activate DbContext
DbContext -> DB: SQL UPDATE Score
activate DB
DB --> DbContext: success
deactivate DB
DbContext --> AppRepo: success
deactivate DbContext
AppRepo --> Svc: ok
deactivate AppRepo

Svc -> CriteriaSvc: ScoreByCriteriaAsync(appId)
activate CriteriaSvc

note right of CriteriaSvc: Loops through Criteria Items,\nEmbeds chunks & calculates matches

CriteriaSvc -> AppRepo: SaveMatchesAsync(matches)
activate AppRepo
AppRepo -> DbContext: AddRange & SaveChanges
activate DbContext
DbContext -> DB: Execute SQL INSERT
activate DB
DB --> DbContext: success
deactivate DB
DbContext --> AppRepo: success
deactivate DbContext
AppRepo --> CriteriaSvc: ok
deactivate AppRepo

CriteriaSvc --> Svc: ok
deactivate CriteriaSvc

Svc --> Worker: return void
deactivate Svc

Worker --> SystemTask: return void
deactivate Worker
@enduml
